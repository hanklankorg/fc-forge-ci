#
# The changelog renderers the render-changelog action installs, consumed by
# forge-ci toolchain install-changelog-renderer.
#
# Each renderer is one release archive, downloaded from its release URL and
# verified against the SHA-256 below before anything is extracted. No tool
# manager and no forge API take part. Rendering runs in its own job, which
# never holds the release signing key.
#
# A version and its two checksums change together: after a version bump,
# replace both with `sha256sum` of the two archives named in the comment, and
# compare them with the checksums the project publishes for the release.

# git-chglog (https://github.com/git-chglog/git-chglog)
#   git-chglog_<version>_linux_amd64.tar.gz, git-chglog_<version>_linux_arm64.tar.gz
# renovate: datasource=github-releases depName=git-chglog/git-chglog
GIT_CHGLOG_VERSION="0.15.4"
GIT_CHGLOG_LINUX_X64_SHA256="03cbeedbd1317289295e75016fa0acd26baeb2fc7810ed287361dd9bd8bc33a8"
GIT_CHGLOG_LINUX_ARM64_SHA256="75d6fcfe1e2f7335a37048e01db53b87035a11ab78a8c3fc2ba65a6e5794f71f"

# git-cliff (https://github.com/orhun/git-cliff)
#   git-cliff-<version>-x86_64-unknown-linux-musl.tar.gz,
#   git-cliff-<version>-aarch64-unknown-linux-musl.tar.gz
# renovate: datasource=github-releases depName=orhun/git-cliff
GIT_CLIFF_VERSION="2.13.1"
GIT_CLIFF_LINUX_X64_SHA256="200d2535da6d9703f3bcc8a4d159c3b55eacdb01cf2148c55b3eee9dd04d5249"
GIT_CLIFF_LINUX_ARM64_SHA256="4054c124b926c117f3fa048939bc8be0a954f29f3b6f367627e8cb22c1971882"
