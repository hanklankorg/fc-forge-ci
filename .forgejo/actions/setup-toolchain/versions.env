#
# Bootstrap-only tool versions consumed by forge-ci toolchain install-mise.
#
# This file pins ONLY the meta-tool (mise). Every other CI tool is managed
# downstream by mise itself (via the consumer's .mise.toml), which gives us
# paranoid integrity verification + a single update surface for Renovate.

# mise — tool version manager (https://github.com/jdx/mise)
# A version and its two checksums change together: after a version bump,
# replace both with the SHA-256 of mise-v<version>-linux-{x64,arm64}-musl.tar.gz.
# renovate: datasource=github-releases depName=jdx/mise
MISE_VERSION="2026.10.19"
MISE_LINUX_X64_MUSL_TAR_GZ_SHA256="8284df180319249d4801b46a34afc5ba9ade5e9c5380ecd14d016f19e90b9ce1"
MISE_LINUX_ARM64_MUSL_TAR_GZ_SHA256="e9111d560bc0014eb83a9491604809bb4d03569d610b1df702369f69d36e3fc0"
