# Signer image for the privileged jobs of the Forgejo layer
# (.forgejo/workflows). forge-ci ships this definition and publishes no
# image: an organization builds it, pushes it to its own registry and passes
# the digest-pinned coordinate as the workflows' signer-image input.
#
# The build context is the repository root, and this file copies exactly one
# file from it:
#
#   buildah build --file containers/signer/Containerfile .
#
# Containerfile.containerignore beside this file cuts the context down to that
# file for Buildah and Podman, so the Git history and the layer's binary are
# not sent to the build.

# Debian trixie: ships skopeo 1.18 (bookworm shipped 1.9.3, whose `--format`
# template engine lacks the `json` function the re-attest label fetch relied on).
FROM docker.io/library/debian:13.7-slim@sha256:62bd423aeee912639ca8ee681c2b762cb3e25137e0a92b20be455898a9f034ad

ARG TARGETARCH

# Renovate's dockerfile manager updates the base image digest above. The three
# toolchain pins below are updated by hand, and that is deliberate: each
# version travels with two architecture digests, no datasource can move all
# three together, and a bumped version beside stale digests only produces a
# build that fails its own sha256sum check. Update the version and both
# digests in one change.
ARG JQ_VERSION=1.8.2
ARG COSIGN_VERSION=3.1.4
ARG SYFT_VERSION=1.57.0

ARG JQ_SHA256_AMD64=b1c22172dd303f3be49e935aa56aa48a8b7a46e0bc838b4997d3bb451495870f
ARG JQ_SHA256_ARM64=8b85c817833814ddca00a144c33705546355afccf0cf39b188f3cdb48b852309
ARG COSIGN_SHA256_AMD64=424e2c97d0b45fd7a6b608a87f090f35633f4c23ece5f092d48bba11aaf4bbfa
ARG COSIGN_SHA256_ARM64=ade83b7aac62e131cacfe96d958948b2150cc9efec46a570a2649b8e27dedad2
ARG SYFT_SHA256_AMD64=9c077a7d43029b3b13e98a8db720661e700c4d58db6352153a06395ae4a2a704
ARG SYFT_SHA256_ARM64=410cbfa0ae0f63246bc0057843760b1de2833cd23919e025e368fd7681308cdb

ENV HOME=/home/signer

# OS packages follow the distribution's update stream when this layer is built.
# Release jobs consume a reviewed signer-image digest; the base digest alone does
# not freeze APT repository contents. Standalone tool downloads are pinned below.
# hadolint ignore=DL3008
RUN set -eux; \
  apt-get update; \
  apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    coreutils \
    curl \
    findutils \
    gawk \
    git \
    gnupg \
    grep \
    openssh-client \
    sed \
    skopeo \
    tar; \
  rm -rf /var/lib/apt/lists/*

# Buildah builds the OCI format, which has no SHELL, so RUN is /bin/sh. The
# checksum pipes need no pipefail: printf cannot fail, and sha256sum's status
# is the pipeline's.
# hadolint ignore=DL4006
RUN set -eux; \
  case "${TARGETARCH}" in \
    amd64) \
      jq_arch=amd64; jq_sha="${JQ_SHA256_AMD64}"; \
      cosign_arch=amd64; cosign_sha="${COSIGN_SHA256_AMD64}"; \
      syft_arch=amd64; syft_sha="${SYFT_SHA256_AMD64}"; \
      ;; \
    arm64) \
      jq_arch=arm64; jq_sha="${JQ_SHA256_ARM64}"; \
      cosign_arch=arm64; cosign_sha="${COSIGN_SHA256_ARM64}"; \
      syft_arch=arm64; syft_sha="${SYFT_SHA256_ARM64}"; \
      ;; \
    *) \
      echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; \
      exit 1; \
      ;; \
  esac; \
  curl -fsSLo /usr/local/bin/jq "https://github.com/jqlang/jq/releases/download/jq-${JQ_VERSION}/jq-linux-${jq_arch}"; \
  printf '%s  /usr/local/bin/jq\n' "${jq_sha}" | sha256sum -c -; \
  chmod 0755 /usr/local/bin/jq; \
  curl -fsSLo /usr/local/bin/cosign "https://github.com/sigstore/cosign/releases/download/v${COSIGN_VERSION}/cosign-linux-${cosign_arch}"; \
  printf '%s  /usr/local/bin/cosign\n' "${cosign_sha}" | sha256sum -c -; \
  chmod 0755 /usr/local/bin/cosign; \
  syft_archive="/tmp/syft.tar.gz"; \
  curl -fsSLo "${syft_archive}" "https://github.com/anchore/syft/releases/download/v${SYFT_VERSION}/syft_${SYFT_VERSION}_linux_${syft_arch}.tar.gz"; \
  printf '%s  %s\n' "${syft_sha}" "${syft_archive}" | sha256sum -c -; \
  tar -xzf "${syft_archive}" -C /usr/local/bin syft; \
  chmod 0755 /usr/local/bin/syft; \
  rm -f "${syft_archive}"

# /workspace below is the WORKDIR and nothing else: the signer jobs stage
# every file under a private /tmp directory they create and remove, so no
# material is kept there. Its mode is 0777 so the WORKDIR stays usable
# whatever UID the container runner starts the job as; restricting it to the
# signer user would fail such a job before its first step and would protect
# a directory that holds nothing. /home/signer, which does hold state, is
# 0700 and owned by that user.
RUN set -eux; \
  addgroup --system --gid 10001 signer; \
  adduser --system --uid 10001 --gid 10001 --home /home/signer --shell /usr/sbin/nologin signer; \
  install -d -m 0700 -o signer -g signer /home/signer; \
  install -d -m 0777 /workspace

COPY .forgejo/scripts/verify-signer-toolchain.sh /usr/local/bin/verify-signer-toolchain
RUN chmod 0755 /usr/local/bin/verify-signer-toolchain \
  && SIGNER_STRICT=1 /usr/local/bin/verify-signer-toolchain

USER 10001:10001
WORKDIR /workspace
