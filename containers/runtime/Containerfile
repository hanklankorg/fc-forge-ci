# SPDX-License-Identifier: CC0-1.0
#
# Shared runtime container for forge-ci.
#
# Multi-stage image. Each stage publishes its own image. Jobs pull only
# the stage they need:
#
#   base    — bash, ca-certificates, curl, git, gnupg, gzip, jq, openssh-client
#             (ssh-keygen, for SSH tag verification), tar, unzip, xz, zip, yq, git-cliff, gh, glab, mise, publiccode-parser, cosign,
#             and the matching architecture's forge-ci binary from this
#             runtime run's cli-dist artifact. Used by config / plan / release /
#             orchestrator / changelog / provider-dispatch / publiccode-lint
#             jobs.
#   full    — base + syft + trivy. Used by security and SBOM jobs.
#   rust    — base + Rust stable toolchain + cargo-cyclonedx. Used by
#             build-cargo and sbom-cargo.
#   go      — base + Go 1.27 toolchain, cyclonedx-gomod, GCC, libc headers
#             and gettext. Used by Go build, race-test and translation jobs.
#   node    — base + Node 24 LTS + npm + corepack. Used by build-npm,
#             publish-snapshot-npm.
#   java    — base + Eclipse Temurin JDK 25 LTS + Maven + Gradle. Used by
#             build-maven, build-gradle-app, publish-maven-central.
#   android — java + Android cmdline-tools + platform-tools + build-tools 35
#             + android-35. NDK is intentionally NOT included (see
#             docs/runtime-images.md).
#
# Scripts are baked at /opt/forge-ci/scripts and templates at
# /opt/forge-ci/templates. The Go binary lives at /usr/local/bin/
# forge-ci. WORKDIR is /workspace.
#
# Every image runs as root unless the job says otherwise: GitHub's
# `container:` jobs and kaniko need it. Each also has the user nonroot,
# UID and GID 65532, home /home/nonroot, for a job that runs its checks as
# an ordinary user (GitLab's image user). The toolchains are read-only for it,
# but for the homes rustup and sdkmanager install into, which it owns, and they
# keep their caches and downloads in the home of whoever runs them:
# ~/.cargo, ~/go, ~/.m2, ~/.gradle, ~/.npm. No image sets HOME; the runtime
# takes it from /etc/passwd. What a job installs itself (go install, cargo
# install, npm install -g) goes to /opt/job-tools, first on PATH.
# Tool versions are pinned via Renovate (datasource comments below or in
# the install-*.sh helpers).
#
# Two unpublished stages come first: go-toolchain holds the Go release the go
# stage ships, and go-tools compiles yq and publiccode-parser with it (see
# there for why).

# DEBIAN_VERSION and GOLANG_IMAGE live in the global ARG scope (before any FROM) because a
# FROM line can only reference ARGs declared globally — a stage-scoped ARG is
# invisible to a later FROM. See the pinning rationale at the base stage below.
# renovate: datasource=docker depName=debian versioning=docker
ARG DEBIAN_VERSION=13-slim@sha256:62bd423aeee912639ca8ee681c2b762cb3e25137e0a92b20be455898a9f034ad
# The Go release (go-toolchain below), Debian trixie like the base.
# renovate: datasource=docker depName=golang versioning=docker
ARG GOLANG_IMAGE=1.27.3-trixie@sha256:fbb7ae40b62ff8afe31662df570d39b4f5052ac32b90dae8e60d7657a20a74f4

# =============================================================================
# Go toolchain (not published; the go stage and go-tools copy it)
# =============================================================================

# The official golang image, pinned by tag and OCI index digest like debian
# above: its build verifies the go.dev release archive against Go's published
# SHA-256, and the digest fixes what this file gets. Its tag is the one Go
# version pin in this file; the workflows' smoke tests read it from here.
FROM golang:${GOLANG_IMAGE} AS go-toolchain

RUN go version

# =============================================================================
# Go tools built from source (not published; base copies the binaries)
# =============================================================================

# yq and publiccode-parser are pure Go, and their release binaries carry the
# standard library of whatever Go their project last released with: a Go
# security fix reached this image only when upstream cut a new release. Built
# here with the Go above, the next Go image bump rebuilds them with the fix.
#
# The versions are the bootstrap helpers' pins, which plain-runner jobs install
# as checksummed release binaries; sourcing the helpers keeps one pin per tool.
# `go install module@version` takes the module from the Go module proxy and
# checks it against the Go checksum database (sum.golang.org), which records
# one immutable hash per module version: that check stands in for the
# helpers' SHA-256 pins. GOTOOLCHAIN=local refuses a module that asks for a
# newer Go instead of fetching one, so the binaries are always built with
# go-toolchain's Go. The flags follow each project's release build (goreleaser): yq
# keeps its version in source; publiccode-parser takes it, and the commit
# date its --version prints, from ldflags.
FROM go-toolchain AS go-tools

ENV CGO_ENABLED=0 \
    GOTOOLCHAIN=local \
    GOBIN=/opt/go-tools

COPY scripts/bootstrap/install-common.sh scripts/bootstrap/install-yq.sh scripts/bootstrap/install-publiccode-parser.sh /tmp/bootstrap/

# A pinned `go install` asks sum.golang.org, which go itself does not retry.
# hadolint ignore=SC1091
RUN bash -c 'set -euo pipefail \
  && source /tmp/bootstrap/install-yq.sh \
  && source /tmp/bootstrap/install-publiccode-parser.sh \
  && retry() { \
       local attempt; \
       for attempt in 1 2 3 4 5; do \
         "$@" && return 0; \
         [[ "$attempt" -eq 5 ]] || sleep $((attempt * 5)); \
       done; \
       return 1; \
     } \
  && publiccode_module=github.com/italia/publiccode-parser-go/v5 \
  && retry go install -trimpath -ldflags "-s -w" "github.com/mikefarah/yq/v4@${YQ_VERSION}" \
  && publiccode_date="$(retry go list -m -f "{{.Time.UTC.Format \"2006-01-02T15:04:05Z\"}}" "${publiccode_module}@${PUBLICCODE_PARSER_VERSION}")" \
  && retry go install -trimpath \
       -ldflags "-s -w -X main.version=${PUBLICCODE_PARSER_VERSION#v} -X main.date=${publiccode_date}" \
       "${publiccode_module}/publiccode-parser@${PUBLICCODE_PARSER_VERSION}" \
  && [[ "$(/opt/go-tools/yq --version)" == *" version ${YQ_VERSION}" ]] \
  && [[ "$(/opt/go-tools/publiccode-parser --version 2>&1)" == "${PUBLICCODE_PARSER_VERSION#v} ${publiccode_date}" ]]' \
  && go version -m /opt/go-tools/yq /opt/go-tools/publiccode-parser

# =============================================================================
# Base stage
# =============================================================================

# Pinned by tag and OCI index digest. The renovate comment on the global ARG
# keeps both values current, while TestRuntimeContainerfileExternalFromImagesAreDigestPinned
# rejects any external base that loses its digest.
FROM debian:${DEBIAN_VERSION} AS base

ARG DEBIAN_FRONTEND=noninteractive

# hadolint ignore=DL3008
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    curl \
    git \
    gnupg \
    gzip \
    jq \
    libatomic1 \
    openssh-client \
    tar \
    unzip \
    xz-utils \
    zip \
  && rm -rf /var/lib/apt/lists/*

# Bootstrap helpers install tools at image build time and in plain-runner jobs.
# Keep their pinned tool versions in the shared helpers where applicable.
COPY scripts/bootstrap /opt/forge-ci/scripts/bootstrap
COPY templates /opt/forge-ci/templates

# The verify/publish jobs verify the matching architecture's canonical delivery
# artifact against .engine/bin/forge-ci-linux-<arch>.sha256 and stage it here.
# COPY preserves those bytes. Version/commit/date-stamped release archives are
# a separate build product and must not replace the delivery binary in runtimes.
COPY cli-prebuilt/forge-ci /usr/local/bin/forge-ci

# yq and publiccode-parser come from go-tools, built with the image's Go.
COPY --from=go-tools /opt/go-tools/yq /opt/go-tools/publiccode-parser /usr/local/bin/

# Install the other binary tools via the shared helpers, then promote them to
# /usr/local/bin and clean up temporary files. PATH reuse is helper-specific:
# cosign always bootstraps the repository-pinned verifier.
# hadolint ignore=SC1091
RUN bash -c 'set -euo pipefail \
  && source /opt/forge-ci/scripts/bootstrap/install-git-cliff.sh && install_git_cliff \
  && install -m 0755 "$(command -v git-cliff)" /usr/local/bin/git-cliff \
  && source /opt/forge-ci/scripts/bootstrap/install-gh.sh && install_gh \
  && install -m 0755 "$(command -v gh)" /usr/local/bin/gh \
  && source /opt/forge-ci/scripts/bootstrap/install-glab.sh && install_glab \
  && install -m 0755 "$(command -v glab)" /usr/local/bin/glab \
  && source /opt/forge-ci/scripts/bootstrap/install-mise.sh && install_mise \
  && install -m 0755 "$(command -v mise)" /usr/local/bin/mise \
  && source /opt/forge-ci/scripts/bootstrap/install-cosign.sh && install_cosign \
  && install -m 0755 "$(command -v cosign)" /usr/local/bin/cosign' \
  && rm -rf /tmp/git-cliff-bin /tmp/gh-bin /tmp/glab-bin /tmp/mise-bin /tmp/cosign-bin \
  && yq --version \
  && git-cliff --version \
  && gh --version \
  && glab --version \
  && mise --version \
  && publiccode-parser --version \
  && cosign version \
  && forge-ci --version

# Git aborts operations on a repository whose on-disk owner differs from the
# invoking process UID ("detected dubious ownership"). In every container-based
# job the workspace is checked out on the host runner and bind-mounted into this
# image, so its owner never matches the in-container UID. The workspace path is
# assigned per repository at run time and is therefore unknown at build time, so
# the exception is scoped to all paths. This image is an ephemeral, single-tenant
# CI sandbox; the broadened scope introduces no multi-tenant exposure.
RUN git config --system --add safe.directory '*'

# The ordinary user a job may run as instead of root, at the UID distroless
# images use. Nothing in the image is its own but its home, /opt/job-tools and,
# in the rust and android images, the toolchain homes that install on demand.
#
# A job's own tools go to /opt/job-tools/bin: GOBIN, CARGO_INSTALL_ROOT and
# NPM_CONFIG_PREFIX name it in the toolchain stages. An install under ~ would
# need ~/go/bin and ~/.cargo/bin on PATH, which ENV cannot expand per user,
# and GitHub's container jobs run with HOME=/github/home; one fixed directory
# works whatever HOME is. Root and nonroot may write it, the image's two users.
RUN groupadd --gid 65532 nonroot \
  && useradd --uid 65532 --gid 65532 --home-dir /home/nonroot --create-home --shell /bin/bash nonroot \
  && install -d -o 65532 -g 65532 -m 0755 /opt/job-tools /opt/job-tools/bin

ENV PATH=/opt/job-tools/bin:$PATH

WORKDIR /workspace

FROM base AS full

# hadolint ignore=SC1091
RUN bash -c 'set -euo pipefail \
  && source /opt/forge-ci/scripts/bootstrap/install-syft.sh && install_syft \
  && install -m 0755 "$(command -v syft)" /usr/local/bin/syft \
  && source /opt/forge-ci/scripts/bootstrap/install-trivy.sh && install_trivy \
  && install -m 0755 "$(command -v trivy)" /usr/local/bin/trivy' \
  && rm -rf /tmp/syft-bin /tmp/trivy-bin \
  && syft version \
  && trivy --version

# =============================================================================
# Rust toolchain (sbom-cargo and any future cargo-driven workflow)
# =============================================================================

FROM base AS rust

# The toolchain and cargo-cyclonedx are installed under /usr/local/cargo and
# /usr/local/rustup. CARGO_HOME is that directory only while the image builds,
# and read-only for any user but root: a job's crates, registry index and git
# checkouts go to its own ~/.cargo, cargo's default, and what it installs to
# /opt/job-tools (CARGO_INSTALL_ROOT, set below). RUSTUP_HOME belongs to
# nonroot, as a rustup home belongs to its user: rustup installs the toolchain,
# components and targets a project's rust-toolchain.toml pins there, and
# `rustup component add` and `rustup target add` write there.
ARG CARGO_HOME=/usr/local/cargo
ENV RUSTUP_HOME=/usr/local/rustup \
    PATH=/usr/local/cargo/bin:$PATH

# renovate: datasource=github-releases depName=rust-lang/rust extractVersion=^(?<version>.*)$
ARG RUST_VERSION=1.99.1
# renovate: datasource=crate depName=cargo-cyclonedx
ARG CARGO_CYCLONEDX_VERSION=0.5.9

# Direct downloads use install-common.sh's bounded curl retries and exponential
# backoff. Permanent HTTP errors such as 404 fail immediately.
# The toolchains other than Go are fetched over HTTPS from each project's own
# host and are not pinned by digest, unlike the signer image's tools: that
# image holds the signing keys, and Renovate bumps these versions, which a
# stale digest would fail.
# Install rustup + the linkers needed for the artifact-first cross-compile
# matrix the build-cargo.yml workflow defaults to (linux/amd64 + linux/arm64).
# Adopters wanting darwin/windows must extend this image or run the build
# on a host that already carries the matching cross-linker — cargo will
# error with a clear `linker not found for target …` message otherwise.
# hadolint ignore=DL3008
RUN apt-get update \
  && apt-get install -y --no-install-recommends gcc libc6-dev gcc-aarch64-linux-gnu \
  && rm -rf /var/lib/apt/lists/* \
  && bash -c 'source /opt/forge-ci/scripts/bootstrap/install-common.sh; ci_download "$@"' -- \
       https://sh.rustup.rs /tmp/rustup-init.sh \
  && sh /tmp/rustup-init.sh -y --no-modify-path \
       --default-toolchain "${RUST_VERSION}" \
       --profile minimal \
  && rm -f /tmp/rustup-init.sh \
  && rustup target add aarch64-unknown-linux-gnu \
  && cargo install --locked cargo-cyclonedx --version "${CARGO_CYCLONEDX_VERSION}" \
  && rm -rf "${CARGO_HOME}/registry" "${CARGO_HOME}/git" \
  && chown -R 65532:65532 "${RUSTUP_HOME}" \
  && rustc --version \
  && cargo --version \
  && cargo cyclonedx --version

# Point cargo at the cross-linker for aarch64. Without this the
# x86_64 default linker is used and aarch64 compiles fail with
# "wrong architecture" link errors.
ENV CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_LINKER=aarch64-linux-gnu-gcc \
    CARGO_INSTALL_ROOT=/opt/job-tools

# =============================================================================
# Go toolchain (build-go, sbom-go)
# =============================================================================

FROM base AS go

# renovate: datasource=github-releases depName=CycloneDX/cyclonedx-gomod
ARG CYCLONEDX_GOMOD_VERSION=v1.12.0

# No GOPATH: modules and the build cache go to the job user's ~/go and
# ~/.cache, Go's defaults, cyclonedx-gomod to /usr/local/bin and what a job
# installs to /opt/job-tools/bin. With GOBIN set, go install refuses a
# cross-compiled binary; go build -o places one.
ENV GOROOT=/usr/local/go \
    GOBIN=/opt/job-tools/bin \
    PATH=/usr/local/go/bin:$PATH

# CGO and the race detector require a C compiler and libc development headers.
# gettext supplies msgmerge, msgen, msgattrib and msgfmt for catalog checks.
# Keep these in the shared Go flavour rather than consumer-specific images.
# hadolint ignore=DL3008
RUN apt-get update \
  && apt-get install -y --no-install-recommends gcc libc6-dev gettext \
  && rm -rf /var/lib/apt/lists/*

# The Go release is go-toolchain's, the one go-tools builds yq and
# publiccode-parser with. A pinned `go install` asks sum.golang.org, which go
# itself does not retry.
COPY --from=go-toolchain /usr/local/go /usr/local/go

RUN for attempt in 1 2 3 4 5; do \
       GOBIN=/usr/local/bin go install "github.com/CycloneDX/cyclonedx-gomod/cmd/cyclonedx-gomod@${CYCLONEDX_GOMOD_VERSION}" && break; \
       if [ "$attempt" -eq 5 ]; then exit 1; fi; \
       sleep $((attempt * 5)); \
     done \
  && rm -rf /root/go /root/.cache/go-build \
  && go version \
  && cyclonedx-gomod version

# =============================================================================
# Node toolchain (build-npm, publish-dev-npm)
# =============================================================================

FROM base AS node

# renovate: datasource=node-version depName=node
ARG NODE_VERSION=24.22.1

# hadolint ignore=DL3008,SC2155
RUN arch="$(dpkg --print-architecture)" \
  && case "$arch" in \
       amd64) node_arch=x64 ;; \
       arm64) node_arch=arm64 ;; \
       *) printf 'unsupported arch: %s\n' "$arch" >&2; exit 1 ;; \
     esac \
  && bash -c 'source /opt/forge-ci/scripts/bootstrap/install-common.sh; ci_download "$@"' -- \
       "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${node_arch}.tar.xz" /tmp/node.tar.xz \
  && tar -xJf /tmp/node.tar.xz -C /usr/local --strip-components=1 \
       --exclude='*.md' --exclude='LICENSE' --exclude='share/doc' --exclude='share/man' \
  && rm -f /tmp/node.tar.xz \
  && corepack enable \
  && node --version \
  && npm --version \
  && corepack --version

# npm install -g puts packages in /opt/job-tools/lib and their commands in
# /opt/job-tools/bin, not in the image's read-only /usr/local.
ENV NPM_CONFIG_PREFIX=/opt/job-tools

# =============================================================================
# Java toolchain (build-maven, build-gradle-app, publish-maven-central)
# Inherits from base; runtime-android extends this stage further.
# =============================================================================

FROM base AS java

# renovate: datasource=adoptium-java depName=temurin
ARG JDK_VERSION=25.0.5+8
# renovate: datasource=maven depName=org.apache.maven:apache-maven extractVersion=^(?<version>.*)$
ARG MAVEN_VERSION=3.10.0
# renovate: datasource=gradle-version depName=gradle
ARG GRADLE_VERSION=8.14.6

ENV JAVA_HOME=/usr/local/jdk \
    MAVEN_HOME=/usr/local/maven \
    GRADLE_HOME=/usr/local/gradle \
    PATH=/usr/local/jdk/bin:/usr/local/maven/bin:/usr/local/gradle/bin:$PATH

# Maven comes from Maven Central, the same file the Apache archive serves
# (and the source Renovate already reads): archive.apache.org throttles CI
# runners, and its timeouts failed a runtime image build. The build fails
# unless `mvn -version` reports exactly MAVEN_VERSION.
# hadolint ignore=DL3008,DL4006
RUN arch="$(dpkg --print-architecture)" \
  && case "$arch" in \
       amd64) jdk_arch=x64 ;; \
       arm64) jdk_arch=aarch64 ;; \
       *) printf 'unsupported arch: %s\n' "$arch" >&2; exit 1 ;; \
     esac \
  && jdk_version_url="$(printf '%s' "$JDK_VERSION" | sed 's/+/%2B/g')" \
  && jdk_version_file="$(printf '%s' "$JDK_VERSION" | tr '+' '_')" \
  && bash -c 'source /opt/forge-ci/scripts/bootstrap/install-common.sh; ci_download "$@"' -- \
       "https://github.com/adoptium/temurin25-binaries/releases/download/jdk-${jdk_version_url}/OpenJDK25U-jdk_${jdk_arch}_linux_hotspot_${jdk_version_file}.tar.gz" \
       /tmp/jdk.tar.gz \
  && mkdir -p "$JAVA_HOME" \
  && tar -xzf /tmp/jdk.tar.gz -C "$JAVA_HOME" --strip-components=1 \
  && rm -f /tmp/jdk.tar.gz \
  && bash -c 'source /opt/forge-ci/scripts/bootstrap/install-common.sh; ci_download "$@"' -- \
       "https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/${MAVEN_VERSION}/apache-maven-${MAVEN_VERSION}-bin.tar.gz" \
       /tmp/maven.tar.gz \
  && mkdir -p "$MAVEN_HOME" \
  && tar -xzf /tmp/maven.tar.gz -C "$MAVEN_HOME" --strip-components=1 \
  && rm -f /tmp/maven.tar.gz \
  && bash -c 'source /opt/forge-ci/scripts/bootstrap/install-common.sh; ci_download "$@"' -- \
       "https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip" \
       /tmp/gradle.zip \
  && unzip -q /tmp/gradle.zip -d /usr/local \
  && mv "/usr/local/gradle-${GRADLE_VERSION}" "$GRADLE_HOME" \
  && rm -f /tmp/gradle.zip \
  && java -version \
  && mvn_banner="$(mvn --batch-mode -version)" \
  && printf '%s\n' "$mvn_banner" \
  && case "$mvn_banner" in \
       "Apache Maven ${MAVEN_VERSION} "*) ;; \
       *) printf 'mvn does not report Maven %s\n' "$MAVEN_VERSION" >&2; exit 1 ;; \
     esac \
  && gradle --version

# =============================================================================
# Android toolchain (build-gradle-android, publish-google-play)
# Inherits from java; intentionally NO NDK (build runtime-android-ndk
# variant when a JNI consumer needs it — see docs/runtime-images.md).
# =============================================================================

FROM java AS android

# renovate: datasource=custom.android-cmdline-tools depName=android-cmdline-tools
ARG ANDROID_CMDLINE_VERSION=16111833
# The platform is the image's line (android-35 in images.json), not an update.
ARG ANDROID_PLATFORM=android-35
# renovate: datasource=custom.android-build-tools depName=android-build-tools
ARG ANDROID_BUILD_TOOLS_VERSION=35.0.1

ENV ANDROID_HOME=/opt/android-sdk \
    ANDROID_SDK_ROOT=/opt/android-sdk \
    PATH=/opt/android-sdk/cmdline-tools/latest/bin:/opt/android-sdk/platform-tools:$PATH

# The SDK belongs to nonroot, so `sdkmanager --install` and the Android Gradle
# Plugin's download of a missing platform or build-tools work for either user.
# The licence pipe needs no pipefail: `yes` always dies of SIGPIPE, and
# sdkmanager's status is the one that counts.
# hadolint ignore=DL3008,DL4006
RUN mkdir -p "$ANDROID_HOME/cmdline-tools" \
  && bash -c 'source /opt/forge-ci/scripts/bootstrap/install-common.sh; ci_download "$@"' -- \
       "https://dl.google.com/android/repository/commandlinetools-linux-${ANDROID_CMDLINE_VERSION}_latest.zip" \
       /tmp/cmdline-tools.zip \
  && unzip -q /tmp/cmdline-tools.zip -d "$ANDROID_HOME/cmdline-tools" \
  && mv "$ANDROID_HOME/cmdline-tools/cmdline-tools" "$ANDROID_HOME/cmdline-tools/latest" \
  && rm -f /tmp/cmdline-tools.zip \
  && { yes 2>/dev/null || true; } | sdkmanager --licenses >/dev/null \
  && sdkmanager --install \
       "platform-tools" \
       "platforms;${ANDROID_PLATFORM}" \
       "build-tools;${ANDROID_BUILD_TOOLS_VERSION}" \
  && rm -rf "$ANDROID_HOME/.android" \
  && chown -R 65532:65532 "$ANDROID_HOME" \
  && sdkmanager --version \
  && adb --version
