# shellcheck shell=sh disable=SC2034,SC2154
credential_trace=0
case $- in
*x*)
	credential_trace=1
	set +x
	;;
esac
curl -fsSL -o probe-json "__JSON_ASSET_URL__"
__JSON_DIGEST_CHECK__chmod +x probe-json
stored="$(./probe-json registry-auth "$registry" <auth.json 2>/dev/null || true)"
if [ -z "$stored" ]; then
	echo "FAIL: container login wrote no usable credential"
	exit 1
fi
