# A flavor: it starts from the one base the release authenticated. The plan
# passes that base as PARENT_IMAGE, pinned by digest; there is no default,
# so the image cannot be built on anything else.
ARG PARENT_IMAGE
FROM ${PARENT_IMAGE}
COPY tools.txt /usr/share/hello/tools.txt
