{
  "name": "@example-org/hello-npm-package",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "@example-org/hello-npm-package",
      "version": "0.1.0",
      "bundleDependencies": [
        "@example-org/greeting"
      ],
      "license": "CC0-1.0",
      "workspaces": [
        "packages/*"
      ],
      "dependencies": {
        "@example-org/greeting": "1.0.0"
      },
      "engines": {
        "node": ">=24"
      }
    },
    "node_modules/@example-org/greeting": {
      "resolved": "packages/greeting",
      "link": true
    },
    "packages/greeting": {
      "name": "@example-org/greeting",
      "version": "1.0.0",
      "license": "CC0-1.0",
      "engines": {
        "node": ">=24"
      }
    }
  }
}
