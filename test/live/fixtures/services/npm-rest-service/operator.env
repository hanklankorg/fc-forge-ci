# set to the Go toolchain root the engine builds with
export GOROOT=
export PATH=${GOROOT:+$GOROOT/bin:}$PATH
# set to the consumer checkout
export FORGE_CI_LIVE_CONSUMER=
export FORGE_CI_LIVE_NPM_APPLICATION_IMAGE=docker.io/library/node:24.17.0-trixie@sha256:61db8992b5c481488fe236ea69fe94035ba73df76a474051ed2e9713f3a15e5a
export FORGE_CI_LIVE_NPM_APPLICATION_ORACLE=$PWD/test/live/fixtures/services/npm-rest-service/installed-oracle.sh
export FORGE_CI_LIVE_NPM_APPLICATION_BRANCH=development
export FORGE_CI_LIVE_CONSUMER_VISIBILITY=public
export FORGE_CI_LIVE_CONSUMER_EVENT=release
export FORGE_CI_LIVE_CONSUMER_SETTINGS='version=2.1.1'
# Select exactly one case; source this file after the lab contract settings.
export LIVEFILTER='^TestForgejoLayer_ConsumerTrial$/public$'
