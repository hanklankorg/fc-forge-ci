# SPDX-License-Identifier: CC0-1.0
#
# Reference Containerfile for a Rust service in a Cargo workspace.
#
# Place this file at <service>/Containerfile (e.g., worker/Containerfile).
# Build context is the workspace root (`context: .` in artifacts.yml) so
# the COPY statements can pull workspace-level Cargo.toml/Cargo.lock and
# every workspace member's Cargo.toml + src.
#
# Three named stages:
# - builder: compiles the binary. Cache mounts (--mount=type=cache) can reuse
#   cargo's registry and target/ on a persistent Buildah worker. forge-ci's
#   cross-run CI cache is a separate registry layer cache.
#   Multi-arch builds use native per-architecture runners;
#   rust:bookworm-slim ships per-arch variants.
# - export-binary: scratch image with the binary at the root. Used by
#   forge-ci's `extract.binary.target: export-binary` to upload the
#   binary as a CI artefact (see ../artifacts.yml).
# - runtime: the deployable image. Lean Debian base + the binary +
#   non-root user.
#
# CI uses daemonless Buildah; Podman uses the same Containerfile locally.
# Local example:
# `podman build --target runtime --build-arg SERVICE=worker .`

# syntax=docker/dockerfile:1.7

ARG RUST_VERSION=1.94
ARG DEBIAN_VARIANT=bookworm-slim

FROM --platform=$BUILDPLATFORM rust:${RUST_VERSION}-${DEBIAN_VARIANT} AS builder
ARG TARGETPLATFORM
WORKDIR /src

# Native build deps for crates that link C libraries (rdkafka, openssl-sys,
# libsasl, libzstd, etc.). Each Containerfile installs only what its
# service needs. Versions intentionally unpinned in this example file —
# real callers should pin via lockfile or version-pin per their policy.
# hadolint ignore=DL3008
RUN apt-get update && apt-get install -y --no-install-recommends \
      cmake libsasl2-dev libzstd-dev libssl-dev pkg-config zlib1g-dev \
 && rm -rf /var/lib/apt/lists/*

# Workspace context: bring in everything cargo needs to resolve.
COPY Cargo.toml Cargo.lock ./
COPY common ./common
COPY worker ./worker
COPY api-service ./api-service
# Add other workspace members as needed.

RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/src/target,id=cargo-${TARGETPLATFORM} \
    cargo build --release --locked -p worker \
 && mkdir -p /out \
 && cp target/release/worker /out/ \
 && cp target/release/admin-tool /out/

FROM scratch AS export-binary
COPY --from=builder /out/worker /worker
COPY --from=builder /out/admin-tool /admin-tool

FROM debian:${DEBIAN_VARIANT} AS runtime
# hadolint ignore=DL3008
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates libsasl2-2 libssl3 libzstd1 \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd -r -g 10001 app \
 && useradd -r -u 10001 -g 10001 -m app
# Numeric, so a runtime such as Kubernetes runAsNonRoot can verify it.
USER 10001:10001
COPY --from=builder /out/worker /usr/local/bin/worker
COPY --from=builder /out/admin-tool /usr/local/bin/admin-tool
ENTRYPOINT ["/usr/local/bin/worker"]
